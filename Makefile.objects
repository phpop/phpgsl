-include gsl.dep
gsl.lo: /workspace/gsl.c
	$(LIBTOOL) --tag=CC --mode=compile $(CC) -I. -I/workspace $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS)   -DZEND_COMPILE_DL_EXT=1 -c /workspace/gsl.c -o gsl.lo  -MMD -MF gsl.dep -MT gsl.lo
$(phplibdir)/gsl.la: ./gsl.la
	$(LIBTOOL) --tag=CC --mode=install cp ./gsl.la $(phplibdir)

./gsl.la: $(shared_objects_gsl) $(GSL_SHARED_DEPENDENCIES)
	$(LIBTOOL) --tag=CC --mode=link $(CC) -shared $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS) $(LDFLAGS)  -o $@ -export-dynamic -avoid-version -prefer-pic -module -rpath $(phplibdir) $(EXTRA_LDFLAGS) $(shared_objects_gsl) $(GSL_SHARED_LIBADD)

